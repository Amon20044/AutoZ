S3_URL=https://project_ref.storage.supabase.co/storage/v1/s3
S3_REGION=project_region
S3_ACCESS_KEY_ID=your_access_key_id
S3_SECRET_ACCESS_KEY=your_secret_access_key
S3_MODELS_BUCKET=Models

NEXT_PUBLIC_SUPABASE_URL=https://project_ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

DATABASE_URL="postgresql://postgres.project_ref:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.project_ref:password@aws-0-region.pooler.supabase.com:5432/postgres"

# ImgBB API key — for image-like visual assets (thumbnails, previews, swatches)
# Get your free key at https://api.imgbb.com/
IMGBB_API_KEY=your_imgbb_api_key
